{
  // Used only by `deno task cli:compile`: without the repo's package.json and
  // node_modules, the binary embeds just @clack/prompts and @bomb.sh/args
  // instead of every app dependency (over 1GB).
  "imports": {
    "@bomb.sh/args": "npm:@bomb.sh/args@0.3.1",
    "@clack/prompts": "npm:@clack/prompts@1.8.1"
  },
  "nodeModulesDir": "none",
  "lock": false
}
