{
  "allowScripts": {
    "allow": [
      "npm:@anthropic-ai/claude-code",
      "npm:@clerk/shared",
      "npm:esbuild",
      "npm:sharp"
    ],
    // These four are denied, not merely unlisted, so Deno never queues them.
    // bufferutil/utf-8-validate compile native addons via node-gyp-build and get
    // OOM-killed in Deno Deploy's build sandbox (exit 137), which SIGTERMs the rest
    // of the queue (exit 143) and leaves the packages uninitialized at import time.
    // They are optional ws perf addons (ws try/catches the require and falls back to
    // JS); protobufjs' postinstall only prints a warning and @google/genai's
    // preinstall is a literal `echo`. Nothing here produces a needed artifact.
    "deny": [
      "npm:@google/genai",
      "npm:bufferutil",
      "npm:protobufjs",
      "npm:utf-8-validate"
    ]
  },
  "unstable": ["kv"],
  "minimumDependencyAge": "0",
  "fmt": {
    "exclude": [
      "**/*.md",
      "**/*.mdx",
      // Undo the top-level exclusion: only `deno check` needs to skip these.
      "!tests/workers/"
    ]
  },
  "lint": {
    "exclude": [
      "!tests/workers/"
    ]
  },
  "exclude": [
    ".astro/",
    ".claude/",
    ".devcontainer/",
    ".github/",
    ".husky/",
    ".vscode/",
    "dist/",
    "node_modules/",
    "src/db",
    "test-results/",
    // `deno check` can't type-check these: they're built against
    // tests/workers/tsconfig.json (`cloudflare:test`, workerd runtime types),
    // which is a different program to the one deno/astro check use. The `fmt`
    // and `lint` sections above opt them back in.
    "tests/workers/",
    "vendor/"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "astro": "deno run --allow-all astro",
    "build": "rm -rf ./.astro ./dist; INLINE_RUNTIME_CHUNK=false deno run -A astro build",
    "dev": "deno run --env-file=.env --allow-all astro dev",
    "e2e-test": "deno task playwright test --project=chromium",
    "e2e-test:ui": "deno task playwright test --ui-port=8080 --ui-host=0.0.0.0",
    // Local-only "malicious user" security-header suite. Builds on `playwright`
    // (remote browser server + .env) but points at its own config, which forces
    // a prod build + preview because the headers only exist in prod.
    "e2e-security": "deno task playwright test --config=playwright.security.config.ts",
    "husky": "deno run --allow-all husky",
    "playwright": "PW_TEST_CONNECT_WS_ENDPOINT='ws://playwright:3000' PW_DISABLE_TS_ESM=1 deno run --env-file=.env --allow-all ./node_modules/.bin/playwright",
    "preview": "deno run -A astro preview",
    "preview:cf": "deno run -A npm:wrangler dev",
    "vitest": "deno run --allow-all vitest",
    // Worker-runtime tests (real simulated KV bindings) run in a separate
    // pool from the jsdom suite above, so they need their own config.
    "vitest:workers": "deno run --allow-all vitest --config vitest.workers.config.ts"
  },
  "test": {
    // exclude these or `deno test` will try to run tests in these folders and fail.
    // tests in those dirs are handled by specific `deno task` calls above
    "exclude": [
      "./tests/vitest/*",
      "./tests/playwright/*",
      "./tests/workers/*"
    ]
  },
  "deploy": {
    "org": "kimdcottrell",
    "app": "kanby"
  }
}
