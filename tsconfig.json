{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "./node_modules/astro/client.d.ts",
    "src/content.config.js",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "playwright-report",
    "test-results",
    // Has its own tsconfig — needs @cloudflare/vitest-pool-workers/types for
    // the `cloudflare:test` module, which isn't in scope here.
    "tests/workers"
  ],
  "types": ["vitest/globals", "deno"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"],
      "@pages/*": ["./src/pages/*"],
      "@src/*": ["./src/*"],
      "@styles/*": ["./src/styles/*"]
    }
  }
}
