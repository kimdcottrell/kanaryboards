.env
.env*
!.env.sample
**/node_modules/*
**/.astro/*
worker-configuration.d.ts
# Local miniflare/wrangler state (simulated KV, caches, dev session data)
.wrangler/
# Generated in CI from wrangler.jsonc with the PR's Worker name + KV namespace id
wrangler.pr.json
# OpenTofu: state holds API token values in plaintext, and tfvars hold the
# Cloudflare account/zone IDs this public repo deliberately does not carry.
**/.terraform/
*.tfstate
*.tfstate.*
*.auto.tfvars
crash.log
src/deno.d.ts
src/policystack.gen.ts
src/policystack.llms.txt
**/dist/*
# ...but keep the vendored Clerk build output — Deno Deploy needs it committed
# to resolve @clerk/astro's ./dist/index.js entry on a fresh checkout.
!vendor/clerk/**/dist/**
HELP.md
./husky/_
**/gitsshkey
**/test-results/*
.devcontainer/home/*
!.devcontainer/home/.gitkeep
!.devcontainer/home/.sample_bashrc
!.devcontainer/home/.sample_zshrc
./tests/playwright/generated.spec.ts
.vscode/settings.json
**/settings.local.json
tests/playwright/.clerk
**/playwright-report/*
